#!/usr/bin/env python3
"""cluster — CLI for the local LLM cluster manager (http://127.0.0.1:11600).

  cluster submit "Rewrite this in title case: ..."          # auto classify + route, wait, print result
  cluster submit --code --tests tests.py "Write is_prime(n)" # code task checked by sandboxed tests
  cluster submit --hidden-tests --tests t.py ...              # tests not shown to the worker (fix loop reveals failures)
  cluster submit --expect "ALPHA" ... / --expect-exact "..."  # deterministic text checks
  cluster submit --route mini|desktop --complexity simple|complex --max-rounds 3 --classify llm --no-wait --json
  cluster status <id> | show <id> | journal [-n 10] | health | alerts [-n 20] | stats
  cluster propose-root --reason "why" -- systemctl restart ollama     # desktop -> mini rootgate (policy + review there)
  cluster onboard [probe.json|device-id|-]   # recommend a role/models/checklist for new hardware
  cluster onboard --apply --yes probe.json   # register in devices.json + flows (never uses sudo)
  cluster onboard --remove <id> --yes
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

BASE = os.environ.get("CLUSTER_URL", "http://127.0.0.1:11600")
ROOT = Path(os.path.expanduser(os.environ.get("LLM_CLUSTER_HOME") or str(Path(__file__).resolve().parents[1])))


def call(path, payload=None, timeout=3600):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(BASE + path, data=data, headers={"Content-Type": "application/json"} if data else {},
                                 method="POST" if data is not None else "GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        sys.exit(f"HTTP {e.code}: {e.read().decode()[:500]}")
    except urllib.error.URLError as e:
        sys.exit(f"manager not reachable at {BASE} ({e}). Try: systemctl --user status llm-cluster-manager")


def summarize(t):
    c = t.get("classification") or {}
    print(f"task {t['id']}: {str(t.get('status')).upper()}  route {t.get('route_initial')} -> {t.get('route_final')}  "
          f"rounds {t.get('rounds_total')}  first-try {t.get('first_try_pass')}  escalated {bool(t.get('escalated'))}")
    print(f"  class: {c.get('complexity')}/{c.get('category')} ({c.get('reason')})")
    for a in t.get("attempts") or []:
        v = a["verdict"]
        print(f"  #{a['n']} {a['phase']:<10} {a['path']:<11} {a['model']:<24} {'PASS' if v.get('pass') else 'FAIL'} "
              f"[{v.get('method')}{' ' + str(v.get('score')) if v.get('score') is not None else ''}] "
              f"{a['wall_s']}s tok/s={a['tok_s']} J={a['energy_j']} J/tok={a['j_per_tok']} score={a['score']}"
              + (f"  failover: {a['failover']}" if a.get("failover") else ""))
        if not v.get("pass") and v.get("issues"):
            print("      fix: " + " / ".join(v["issues"])[:400])
    if t.get("timings"):
        print(f"  time {t['timings']['total_s']}s (worker {t['timings']['worker_s']}s, checks {t['timings']['check_s']}s); "
              f"energy worker {t['energy']['worker_j']} J + checks {t['energy']['check_j']} J")
    print(f"  journal: {ROOT}/journal/tasks/{t['id']}.md")


def _onboard_mod():
    sys.path.insert(0, str(ROOT))
    from onboard.advisor import (  # type: ignore
        advise, apply_advice, instructions, load_cluster_context, load_probe_arg,
        remove_device, render_advice,
    )
    return advise, apply_advice, instructions, load_cluster_context, load_probe_arg, remove_device, render_advice


def _confirm(prompt: str, assumed_yes: bool) -> bool:
    if assumed_yes:
        return True
    if not sys.stdin.isatty():
        sys.exit("refusing to apply without --yes (stdin is not a TTY)")
    try:
        ans = input(prompt + " [yes/No] ").strip().lower()
    except EOFError:
        ans = ""
    return ans in ("y", "yes")


def _reload_manager_flows():
    """Best-effort: tell the running manager to load extra_flows.json. Never fatal."""
    try:
        call("/api/onboard/reload", {})
        return True, None
    except SystemExit as e:
        return False, str(e)
    except Exception as e:  # noqa: BLE001
        return False, str(e)


def cmd_onboard(args):
    advise, apply_advice, instructions, load_cluster_context, load_probe_arg, remove_device, render_advice = _onboard_mod()
    ctx = load_cluster_context()

    if args.remove:
        if not _confirm(f"Remove {args.remove} from devices.json and extra flows?", args.yes):
            sys.exit("aborted")
        result = remove_device(args.remove, confirm=True)
        ok, err = _reload_manager_flows()
        result["manager_reloaded"] = ok
        if err and not ok:
            result["manager_reload_error"] = err
        if args.json:
            print(json.dumps(result, indent=2, ensure_ascii=False))
        else:
            print(f"removed {result['id']}")
            if result.get("backup_devices"):
                print(f"  backup: {result['backup_devices']}")
            if not ok:
                print("  manager did not reload flows automatically; run: systemctl --user restart llm-cluster-manager")
        return

    if not args.target:
        info = instructions(ctx)
        if args.json:
            print(json.dumps(info, indent=2, ensure_ascii=False))
        else:
            sys.stdout.write(info["markdown"] if not info["markdown"].endswith("\n") else info["markdown"])
            if not info["markdown"].endswith("\n"):
                sys.stdout.write("\n")
        return

    try:
        probe = load_probe_arg(args.target, ctx)
    except (FileNotFoundError, ValueError, json.JSONDecodeError) as e:
        sys.exit(str(e))
    advice = advise(probe, role=args.role, device_id=args.id, ctx=ctx)

    if args.apply:
        if advice.get("protected"):
            sys.exit(f"refusing to apply: {advice['device']['id']} is a protected existing device")
        print(render_advice(advice))
        if not _confirm(f"Register {advice['device']['id']} in devices.json and extra flows?", args.yes):
            sys.exit("aborted")
        try:
            result = apply_advice(advice, confirm=True, update=args.update)
        except ValueError as e:
            sys.exit(str(e))
        ok, err = _reload_manager_flows()
        result["manager_reloaded"] = ok
        if err and not ok:
            result["manager_reload_error"] = err
        if args.json:
            print(json.dumps({"advice": advice, "apply": result}, indent=2, ensure_ascii=False))
        else:
            print(f"registered {result['id']}")
            if result.get("backup_devices"):
                print(f"  backup: {result['backup_devices']}")
            if result.get("flows_added"):
                print("  flows: " + ", ".join(result["flows_added"]))
            if not ok:
                print("  manager did not reload flows automatically; run: systemctl --user restart llm-cluster-manager")
        return

    if args.json:
        print(json.dumps(advice, indent=2, ensure_ascii=False))
    else:
        sys.stdout.write(render_advice(advice))


def main():
    ap = argparse.ArgumentParser(prog="cluster", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("submit")
    s.add_argument("text", nargs="?", help="task text (or - / --file)")
    s.add_argument("--file")
    s.add_argument("--code", action="store_true")
    s.add_argument("--tests")
    s.add_argument("--hidden-tests", action="store_true")
    s.add_argument("--expect", action="append", default=[])
    s.add_argument("--expect-exact")
    s.add_argument("--route", default="auto", choices=["auto", "mini", "desktop"])
    s.add_argument("--complexity", default="auto", choices=["auto", "simple", "complex"])
    s.add_argument("--classify", default="heuristic", choices=["heuristic", "llm"])
    s.add_argument("--max-rounds", type=int)
    s.add_argument("--no-wait", action="store_true")
    s.add_argument("--json", action="store_true")
    s.add_argument("--print-output", action="store_true", help="print the final output too")
    for name in ("status", "show"):
        x = sub.add_parser(name)
        x.add_argument("id")
    j = sub.add_parser("journal")
    j.add_argument("-n", type=int, default=10)
    sub.add_parser("health")
    a = sub.add_parser("alerts")
    a.add_argument("-n", type=int, default=20)
    sub.add_parser("stats")
    p = sub.add_parser("propose-root")
    p.add_argument("--reason", required=True)
    p.add_argument("argv", nargs=argparse.REMAINDER)
    o = sub.add_parser("onboard", help="recommend a role and models for new hardware; optionally register it")
    o.add_argument("target", nargs="?", help="probe JSON path, existing device id/IP/name, or - for stdin")
    o.add_argument("--role", choices=["gpu-worker", "cpu-worker", "reviewer", "embeddings",
                                      "storage/memory", "monitor/sentinel", "controller", "peripheral"])
    o.add_argument("--id", help="override the suggested device id")
    o.add_argument("--apply", action="store_true", help="register in devices.json + extra flows (never sudo)")
    o.add_argument("--update", action="store_true", help="with --apply, overwrite an existing non-protected entry")
    o.add_argument("--remove", metavar="ID", help="unregister a non-protected device")
    o.add_argument("--yes", action="store_true", help="confirm --apply / --remove without a prompt")
    o.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.cmd == "submit":
        text = args.text
        if args.file:
            text = Path(args.file).read_text()
        elif text in (None, "-"):
            text = sys.stdin.read()
        task = {"text": text, "type": "code" if (args.code or args.tests) else "auto", "route": args.route,
                "complexity": args.complexity, "classify": args.classify, "hidden_tests": args.hidden_tests,
                "expect": args.expect, "wait": not args.no_wait, "source": "cli"}
        if args.expect_exact is not None:
            task["expect_exact"] = args.expect_exact
        if args.tests:
            task["tests"] = Path(args.tests).read_text()
        if args.max_rounds:
            task["max_rounds"] = args.max_rounds
        t = call("/task", task)
        if args.json:
            print(json.dumps(t, indent=2, ensure_ascii=False))
        elif args.no_wait:
            print(t["id"])
        else:
            summarize(t)
            if args.print_output:
                print("\n--- final output ---\n" + (t.get("final_output") or ""))
    elif args.cmd == "status":
        t = call(f"/task/{args.id}")
        summarize(t) if t.get("attempts") is not None else print(json.dumps(t, indent=2))
    elif args.cmd == "show":
        p = ROOT / "journal" / "tasks" / f"{args.id}.md"
        print(p.read_text() if p.exists() else json.dumps(call(f"/task/{args.id}"), indent=2))
    elif args.cmd == "journal":
        for t in call(f"/tasks?n={args.n}")["tasks"]:
            c = t.get("classification") or {}
            print(f"{t['id']}  {t['status']:<11} {c.get('complexity','?'):<7} {c.get('category','?'):<14} "
                  f"{str(t.get('route_initial')):<7}-> {str(t.get('route_final')):<11} rounds={t.get('rounds_total')} "
                  f"{t['timings']['total_s']}s  {t['task']['text'][:60]!r}")
    elif args.cmd == "health":
        print(json.dumps(call("/health"), indent=2))
    elif args.cmd == "alerts":
        for a in call(f"/alerts?n={args.n}")["alerts"]:
            print(f"{a['ts']} [{a['level']}] {a.get('from')}→{a.get('about')}: {a['msg']}")
    elif args.cmd == "stats":
        print(call("/cluster/stats").get("markdown") or "no tasks yet")
    elif args.cmd == "propose-root":
        argv = args.argv[1:] if args.argv and args.argv[0] == "--" else args.argv
        print(json.dumps(call("/cluster/rootgate/propose", {"argv": argv, "reason": args.reason}), indent=2))
    elif args.cmd == "onboard":
        cmd_onboard(args)


if __name__ == "__main__":
    main()
