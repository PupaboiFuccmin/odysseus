#!/bin/bash
# OPT-IN PUBLIC EXPOSURE: Expose llm-cluster-offload (127.0.0.1:11630) via Tailscale Funnel (:8443).
# WARNING: Anyone on the public internet can reach :8443; security relies on your Bearer token
# (secret/offload.token), rate limits, and path_allowlist in offload/offload.json.
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { echo "Run as root: sudo bash $0" >&2; exit 1; }
tailscale funnel --bg --yes --https=8443 http://127.0.0.1:11630
tailscale funnel status
