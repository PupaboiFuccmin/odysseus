#!/bin/bash
# Expose Odysseus (localhost:7011) over HTTPS on your Tailscale tailnet ONLY (not public internet).
# Replace <USER> with your local Linux username before running with sudo.
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { echo "Run as root: sudo bash $0" >&2; exit 1; }
tailscale set --operator="<USER>"
tailscale serve --bg --https=443 http://127.0.0.1:7011
tailscale serve status
