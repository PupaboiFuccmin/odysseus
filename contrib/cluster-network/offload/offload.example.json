{
  "_doc": "Frontier Agent Offload config. Copy to offload/offload.json and add your Tailscale IP + allowlisted paths.",
  "port": 11630,
  "bind": [
    "127.0.0.1"
  ],
  "allowed_hosts": [
    "127.0.0.1:*",
    "localhost:*"
  ],
  "allowed_origins": [
    "http://127.0.0.1:*",
    "http://localhost:*"
  ],
  "token_file": "secret/offload.token",
  "manager": "http://127.0.0.1:11600",
  "chromadb": "http://127.0.0.1:8100",
  "embed": {
    "url": "http://127.0.0.1:11434",
    "model": "nomic-embed-text",
    "keep_alive": "30s"
  },
  "collections": {
    "memory": "llm_cluster_memory",
    "tasks": "llm_cluster_tasks"
  },
  "nodes": {
    "desktop": {
      "id": "manager-node",
      "ollama": "http://127.0.0.1:11434",
      "text_model": "gemma4:12b",
      "code_model": "qwen3-coder-30b:latest",
      "num_ctx": 8192,
      "concurrency": 2
    },
    "mini": {
      "id": "worker-node",
      "ollama": "http://192.0.2.20:11434",
      "text_model": "qwen2.5:7b",
      "fast_model": "qwen2.5:3b",
      "code_model": "qwen2.5-coder:7b",
      "num_ctx": 4096,
      "concurrency": 2
    }
  },
  "limits": {
    "max_request_bytes": 10485760,
    "max_upload_bytes": 5242880,
    "max_input_chars": 2000000,
    "max_chunks": 48,
    "chunk_chars_text": 6000,
    "chunk_chars_code": 10000,
    "chunk_overlap_chars": 200,
    "max_concurrent_jobs": 4,
    "rate_limit_heavy_rpm": 30,
    "rate_limit_read_rpm": 120,
    "url_max_bytes": 2097152,
    "job_ttl_s": 86400,
    "upload_ttl_s": 86400
  },
  "path_allowlist": [],
  "path_denylist_globs": [
    "**/secret/**",
    "**/*.token",
    "**/.env",
    "**/.env.*",
    "**/.git/**",
    "**/venv/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/state/*.sqlite*"
  ]
}
