[Unit]
Description=LLM cluster Frontier Agent Offload (:11630)
After=network-online.target llm-cluster-manager.service
Wants=llm-cluster-manager.service

[Service]
Type=simple
Environment=LLM_CLUSTER_HOME=@INSTALL_DIR@
ExecStart=@BRIDGE_PYTHON_BIN@ -u @INSTALL_DIR@/offload/offload_server.py
WorkingDirectory=@INSTALL_DIR@/offload
Restart=on-failure
RestartSec=10
Nice=10
MemoryMax=2G

[Install]
WantedBy=default.target
